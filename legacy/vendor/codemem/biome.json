{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noUselessTernary": "error",
				"noUselessTypeConstraint": "error",
				"useOptionalChain": "error"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"better-sqlite3": {
								"importNames": ["default"],
								"message": "Runtime SQLite imports are daemon-owned; use the audited actor boundary."
							},
							"@codemem/core": {
								"importNames": [
									"connect",
									"connectReadOnly",
									"MemoryStore",
									"ReadOnlyActor",
									"WriterActor"
								],
								"message": "DB handles and stores are daemon-owned runtime capabilities."
							}
						},
						"patterns": [
							{
								"group": ["@codemem/core/*"],
								"message": "Deep core imports bypass the public sole-writer boundary."
							}
						]
					}
				},
				"useConst": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noTemplateCurlyInString": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on"
				}
			}
		}
	},
	"files": {
		"includes": [
			"packages/**/src/**/*.ts",
			"packages/**/src/**/*.tsx",
			"packages/**/src/**/*.js",
			"packages/**/*.json",
			"packages/**/vite.config.ts",
			"vitest.config.ts",
			"tsconfig.base.json",
			"tsconfig.json",
			"biome.json"
		]
	},
	"overrides": [
		{
			"includes": [
				"packages/core/src/daemon-lifecycle.ts",
				"packages/core/src/writer-actor.ts",
				"packages/core/src/test-utils.ts",
				"packages/**/src/**/*.test.ts",
				"packages/**/src/**/*.test.tsx",
				"packages/**/src/**/*.eval.test.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noAutofocus": "off"
					}
				}
			}
		}
	]
}
