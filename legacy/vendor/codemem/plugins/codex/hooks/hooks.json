            "timeout": 5,
            "statusMessage": "codemem SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-runtime.mjs\" codex-hook-inject",
