            "statusMessage": "codemem UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-runtime.mjs\" codex-hook-ingest",
            "timeout": 5,
