{
	"name": "@codemem/core",
	"version": "0.40.2",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "pnpm exec vite build && pnpm exec tsc --build --force",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"generate:test-schema": "pnpm exec tsx scripts/generate-test-schema.ts",
		"prepublishOnly": "node ../../../../harness/notice-inclusion-check.mjs",
		"typecheck": "pnpm exec tsc --noEmit"
	},
	"devDependencies": {
		"@types/better-sqlite3": "catalog:",
		"rollup-plugin-license": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@xenova/transformers": "^2.17.2",
		"better-sqlite3": "12.8.0",
		"bonjour-service": "^1.4.0",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"limiter": "catalog:",
		"sqlite-vec": "0.1.9"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kunickiaj/codemem.git",
		"directory": "packages/core"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
