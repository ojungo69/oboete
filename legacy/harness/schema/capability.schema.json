{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/harness/schema/capability.schema.json",
  "$defs": {
    "limitationCodes": {
      "$comment": "matrix へ出るのはこちら。散文の limitations は fixture 内に残す。limitations と同じ長さで位置対応させる",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "assistant-completion-synthesized-from-stop",
          "codex-home-in-tmp-warns",
          "empty-tool-response-ambiguous",
          "failure-phase-not-directly-observable",
          "failure-phases-not-reached",
          "headless-only-no-tty",
          "hook-timeout-not-observable",
          "hooks-config-requires-table-form",
          "interrupt-evidence-in-subset-of-captures",
          "interrupt-observed-via-signal-only",
          "interrupt-requires-pattern-synthesis",
          "post-tool-use-absent-on-failure",
          "post-tool-use-fires-on-failure-without-status",
          "session-end-reason-always-other",
          "session-start-injection-echoed",
          "stop-not-fired-on-sigint",
          "subagent-identity-present-in-payload",
          "subagent-internals-not-visible-to-parent",
          "subagent-start-appears-as-agent-tool",
          "tool-start-payload-carries-ids",
          "turn-boundary-native-via-turn-id",
          "turn-boundary-via-shared-prompt-id"
        ]
      }
    }
  },
  "title": "CaptureFixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "cli",
    "nativeVersion",
    "capturedAt",
    "scenario",
    "scenarioId",
    "observedEvents",
    "toolFailurePhasesObserved",
    "limitations",
    "limitationCodes",
    "rig"
  ],
  "properties": {
    "fixtureId": {
      "$comment": "matrix の fixtureIds / sourceFixtureId / evidenceSources / 生成 limitations へ出る。自由文を通すと 4 経路へ漏れる",
      "type": "string",
      "pattern": "^(claude|codex)/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cli": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "nativeVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,63}$",
      "$comment": "公開 matrix と診断へそのまま出る。path 区切りと記号を落として自由文の器にしない"
    },
    "capturedAt": {
      "$comment": "manifest 付きの証拠では manifest 側と照合する。verifiedAt としてそのまま成果物へ出るため、自由文を通さない",
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "observedEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "session_started",
              "user_prompted",
              "assistant_completed",
              "tool_started",
              "tool_completed",
              "tool_failed",
              "turn_completed",
              "pre_compact",
              "post_compact",
              "session_idle",
              "session_interrupted",
              "session_ended",
              "raw"
            ]
          },
          "raw": true,
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
          },
          "capability": {
            "type": "string",
            "enum": [
              "native",
              "synthesized"
            ]
          },
          "sourceEvents": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PostToolUse",
                "PreToolUse",
                "SessionEnd",
                "SessionStart",
                "Stop",
                "SubagentStop",
                "UserPromptSubmit"
              ]
            }
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitationCodes": {
            "$ref": "#/$defs/limitationCodes"
          }
        },
        "allOf": [
          {
            "$comment": "§7.2: synthesized は根拠 native event の明示が必須",
            "if": {
              "properties": {
                "capability": {
                  "const": "synthesized"
                }
              },
              "required": [
                "capability"
              ]
            },
            "then": {
              "required": [
                "sourceEvents"
              ],
              "properties": {
                "sourceEvents": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "toolFailurePhasesObserved": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "executed",
          "permission_denied",
          "schema_invalid",
          "unknown_tool",
          "interrupt",
          "unknown"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolated",
        "internalRunMarker"
      ],
      "properties": {
        "isolated": {
          "type": "boolean",
          "const": true
        },
        "internalRunMarker": {
          "type": "boolean"
        }
      }
    },
    "highLevel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionStartInjection": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "promptAwareInjection": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "promptDeliveryBeforeModel": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "compactSingleDelivery": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "trueSessionEnd": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "subagentCapture": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "stableNativeSessionId": {
          "type": "string",
          "enum": [
            "native",
            "synthesized",
            "unsupported"
          ]
        },
        "compactionRecoveryStrategy": {
          "type": "string",
          "enum": [
            "native_pre_and_post",
            "native_pre_next_prompt",
            "session_compaction_event",
            "turn_checkpoint_detect_reset",
            "unsupported"
          ]
        }
      }
    },
    "scenarioId": {
      "$comment": "matrix へ出る scenario 識別子。自由文の scenario は fixture 内の説明として残し matrix へ出さない",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "limitationCodes": {
      "$ref": "#/$defs/limitationCodes"
    },
    "evidence": {
      "$comment": "実 CLI 観測を根拠とする fixture の観測記録。minItems 1 は空虚真の遮断（every は空配列で真になる）",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "evidenceHash",
          "captureRawHash",
          "normalizationVersion"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.jsonl$"
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "captureRawHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalizationVersion": {
            "type": "integer",
            "minimum": 1
          },
          "manifest": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.manifest\\.json$"
          },
          "manifestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "$comment": "manifest と manifestHash は両方あるか両方無いか。dependentRequired は validate.ts が対応していない",
            "if": {
              "required": [
                "manifest"
              ]
            },
            "then": {
              "required": [
                "manifestHash"
              ]
            }
          },
          {
            "if": {
              "required": [
                "manifestHash"
              ]
            },
            "then": {
              "required": [
                "manifest"
              ]
            }
          }
        ]
      }
    }
  }
}
