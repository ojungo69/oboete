+/// Spike only: the work-view bundle, read from OBOETE_WORK_VIEW_DIR at each request.
+fn work_view_file(path: &str) -> Response {
+    let Some(dir) = std::env::var_os("OBOETE_WORK_VIEW_DIR") else {
+        return Response::text(404, "not found");
+    };
+    let rel = match path.strip_prefix("/work-view/").unwrap_or("") {
+        "" => "index.html",
+        r => r,
+    };
+    if rel.split('/').any(|s| s.is_empty() || s == "." || s == "..") || rel.contains('\\') {
+        return Response::text(404, "not found");
+    }
+    let ctype = match rel.rsplit('.').next() {
+        Some("html") => "text/html; charset=utf-8",
+        Some("js") => "text/javascript; charset=utf-8",
+        Some("css") => "text/css; charset=utf-8",
+        Some("woff2") => "font/woff2",
+        Some("woff") => "font/woff",
+        Some("webp") => "image/webp",
+        Some("svg") => "image/svg+xml",
+        Some("png") => "image/png",
+        Some("ico") => "image/x-icon",
+        _ => return Response::text(404, "not found"),
+    };
+    let headers = if std::env::var_os("OBOETE_WORK_VIEW_STRICT").is_some() {
+        SECURITY_HEADERS
+    } else {
+        WORK_VIEW_HEADERS
+    };
+    match std::fs::read(std::path::Path::new(&dir).join(rel)) {
+        Ok(body) => Response {
+            headers,
+            ..Response::new(200, ctype, body)
+        },
+        Err(_) => Response::text(404, "not found"),
+    }
+}
