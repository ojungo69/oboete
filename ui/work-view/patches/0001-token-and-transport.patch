+    await advance(0)
+    assert.equal(sent.length, 1)
+    source.close()
+    await settle()
+    assert.equal(sent[0].request.signal.aborted, true)
+    assert.equal(count('error'), 0)
+    await advance(60_000)
+    assert.equal(sent.length, 1)
+  })
+
+  it('gives up a stalled answer at its deadline and asks again at the next tick', async () => {
+    const { installLocalApiToken } = await client()
+    const state: { v: number; version?: Answer } = { v: 1, version: stalled }
+    const { win, sent } = fakeWindow({ hash: '#t=abc', answer: viewer(state) })
+    installLocalApiToken(win)
+    const { events, count } = stream(win)
+    await advance(0)
+    await advance(19_999)
+    assert.equal(count('error'), 0)
+    await advance(1)
+    assert.deepEqual(events.at(-1), { type: 'error', readyState: 0 })
+    assert.equal(sent[0].request.signal.aborted, true)
+    state.version = undefined
+    await advance(3000)
+    assert.equal(sent.filter((s) => s.path === '/api/work-view/version').length, 2)
+    assert.equal(count('open'), 1)
+  })
+
+  it('gives up a body that stops coming at the same deadline', async () => {
+    const { installLocalApiToken } = await client()
+    const state: { v: number; page?: Answer } = { v: 1, page: stalledBody }
+    const { win, sent } = fakeWindow({ hash: '#t=abc', answer: viewer(state) })
+    installLocalApiToken(win)
+    const { events, count } = stream(win)
+    await advance(0)
+    assert.equal(count('open'), 1)
+    await advance(20_000)
+    assert.deepEqual(events.at(-1), { type: 'error', readyState: 0 })
+    state.page = undefined
+    await advance(3000)
+    assert.equal(count('work-view'), 1)
+    assert.equal(sent.filter((s) => s.path === '/api/work-view').length, 2)
+  })
+
+  it('polls no more while the tab is hidden, and at once when it shows again', async () => {
+    const { installLocalApiToken } = await client()
+    const { win, sent, document } = fakeWindow({ hash: '#t=abc', answer: viewer({ v: 1 }) })
+    installLocalApiToken(win)
+    stream(win)
+    await advance(0)
