+// An answer that never comes, as a stalled viewer's: it fails only when its request is aborted.
+const stalled = (request: Request): Promise<Response> =>
+  new Promise((_resolve, reject) => request.signal.addEventListener('abort', () => reject(request.signal.reason)))
+
+// Headers that come and a body that never ends, until the request is aborted, as fetch does.
+const stalledBody = (request: Request): Response =>
+  new Response(new ReadableStream({ start(controller) { request.signal.addEventListener('abort', () => controller.error(request.signal.reason)) } }))
+
+function fakeWindow({ hash = '', stored = {}, answer }: { hash?: string; stored?: Record<string, string>; answer: Answer }) {
+  const storage = new Map<string, string>(Object.entries(stored))
+  const sent: { path: string; token: string | null; request: Request }[] = []
+  const banners: string[] = []
+  const document = Object.assign(new EventTarget(), {
+    visibilityState: 'visible' as 'visible' | 'hidden',
+    createElement: () => ({ setAttribute() {}, style: {}, textContent: '' }),
+    body: { prepend: (bar: { textContent: string }) => { banners.push(bar.textContent) } },
+  })
+  const location = { href: `${ORIGIN}/work-view/${hash}`, origin: ORIGIN, hash, pathname: '/work-view/', search: '', reload() {} }
+  const win = Object.assign(new EventTarget(), {
+    document,
+    location,
+    history: {
+      state: null,
+      replaceState(_state: unknown, _title: string, next: string) {
+        const url = new URL(next, ORIGIN)
+        location.href = url.href
+        location.hash = url.hash
+      },
+    },
+    localStorage: {
+      getItem: (key: string) => storage.get(key) ?? null,
+      setItem: (key: string, value: string) => { storage.set(key, String(value)) },
+      removeItem: (key: string) => { storage.delete(key) },
+    },
+    fetch: async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+      const request = input instanceof Request ? input : new Request(input, init)
+      sent.push({ path: new URL(request.url).pathname, token: request.headers.get('X-Oboete-Token'), request })
+      return answer(request)
+    },
+    EventSource: class {} as unknown as new (url: string) => PollingSource,
+  })
+  return { win, storage, sent, banners, document }
+}
+
+// The viewer's two paths, with the version and the snapshot the test sets; any other path is 404.
+function viewer(state: { v: number; snapshot?: unknown; version?: Answer; page?: Answer }): Answer {
+  return (request) => {
+    const path = new URL(request.url).pathname
+    if (path === '/api/work-view/version') return state.version ? state.version(request) : json({ v: state.v })
+    if (path === '/api/work-view') return state.page ? state.page(request) : json(state.snapshot ?? SNAPSHOT)
+    return new Response('not found', { status: 404 })
+  }
