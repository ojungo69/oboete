+
+  it('cancels the poll in flight when it is closed', async () => {
+    const { installLocalApiToken } = await client()
+    const { win, sent } = fakeWindow({ hash: '#t=abc', answer: viewer({ v: 1, version: stalled }) })
+    installLocalApiToken(win)
