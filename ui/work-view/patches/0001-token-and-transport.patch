+
+  it('errors at readyState 0 on a 401, and polls no more', async () => {
+    const { installLocalApiToken } = await client()
+    const state = { v: 1, version: () => new Response('', { status: 401 }) }
+    const { win, sent } = fakeWindow({ hash: '#t=abc', answer: viewer(state) })
