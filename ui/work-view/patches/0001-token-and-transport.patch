+    installLocalApiToken(win)
+    const { count } = stream(win)
+    const pages = () => sent.filter((s) => s.path === '/api/work-view').length
+    await advance(0)
+    assert.equal(pages(), 1)
+    for (let tick = 0; tick < 19; tick += 1) await advance(3000)
+    assert.equal(pages(), 1)
+    await advance(3000)
+    assert.equal(pages(), 2)
+    assert.equal(count('work-view'), 2)
+  })
+
+  it('reads the page again for a moved version at the next tick', async () => {
+    const { installLocalApiToken } = await client()
+    const state = { v: 1 }
+    const { win, sent } = fakeWindow({ hash: '#t=abc', answer: viewer(state) })
+    installLocalApiToken(win)
+    stream(win)
+    await advance(0)
+    state.v = 2
+    await advance(3000)
+    assert.equal(sent.filter((s) => s.path === '/api/work-view').length, 2)
+  })
+
+  it('moves neither the version nor the minute for a snapshot the page would drop, and says why', async () => {
+    const { installLocalApiToken } = await client()
+    const state: { v: number; page?: Answer } = { v: 1 }
+    const { win, sent } = fakeWindow({ hash: '#t=abc', answer: viewer(state) })
+    installLocalApiToken(win)
+    const { source, count } = stream(win)
+    const beats: { connected: boolean; error: string | null }[] = []
+    source.addEventListener('heartbeat', (event) => beats.push(JSON.parse((event as unknown as { data: string }).data).source))
+    const pages = () => sent.filter((s) => s.path === '/api/work-view').length
+    await advance(0)
+    assert.equal(count('work-view'), 1)
+    // A moved version whose answer is no JSON at all: dropped, said, and read again at the next tick.
+    state.v = 2
+    state.page = () => new Response('<html>not a work view', { status: 200 })
+    await advance(3000)
+    assert.equal(count('work-view'), 1)
+    assert.deepEqual(beats.at(-1), { ...beats.at(-1), connected: false, error: 'The viewer sent something that is not a work view.' })
+    await advance(3000)
+    assert.equal(pages(), 3)
+    state.page = undefined
+    await advance(3000)
+    assert.equal(count('work-view'), 2)
+    assert.equal(beats.at(-1)?.connected, true)
+    // The same version at the minute, with a snapshot claude-mem's check drops: read again at the next tick, not a
+    // minute later.
+    state.page = () => json({ source: { connected: true } })
+    const taken = pages()
+    for (let tick = 0; tick < 19; tick += 1) await advance(3000)
+    assert.equal(pages(), taken)
+    await advance(3000)
+    assert.equal(pages(), taken + 1)
+    await advance(3000)
+    assert.equal(pages(), taken + 2)
+    assert.equal(count('work-view'), 2)
+  })
+})
