+// types (tsconfig.node.json), which the client's own signature names.
+type Client = { installLocalApiToken(win: FakeWindow): string }
+
+// The client keeps whether its token was refused for the page's life: a page of its own per test.
+let pages = 0
+async function client(): Promise<Client> {
+  pages += 1
+  return (await import(`../../../local-api-token-client.ts?page=${pages}`)) as Client
+}
+
+const json = (value: unknown, status = 200): Response =>
+  new Response(JSON.stringify(value), { status, headers: { 'content-type': 'application/json' } })
