+// Added by oboete (ui/work-view/patches/0001-token-and-transport.patch): the token client and the
+// polling transport that replace claude-mem's (src/ui/local-api-token-client.ts), run against a fake
+// window. claude-mem's `npm test` runs this file with its own (issue #1085).
+import assert from 'node:assert/strict'
+import { afterEach, beforeEach, describe, it, mock } from 'node:test'
+
+const ORIGIN = 'http://work-view.localhost:17373'
+const KEY = 'oboete-work-view-token'
+const SNAPSHOT = { humanRequests: [], source: { connected: true } }
+
+type Answer = (request: Request) => Response | Promise<Response>
+// The polling stream the client puts in the window's EventSource, as this file reads it.
+type PollingSource = EventTarget & { readyState: number; close(): void }
+type FakeWindow = ReturnType<typeof fakeWindow>['win']
