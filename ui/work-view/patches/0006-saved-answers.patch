@@ -0,0 +1,518 @@
+// oboete (ui/work-view/patches/0006-saved-answers.patch, #1108): a save's answer as the pages take it
+// on oboete's transport. oboete polls in place of claude-mem's event stream (0001), so a poll read
+// before a save can land while the save waits, its content the one on screen; and a write whose
+// snapshot did not read answers claude-mem's receipt alone.
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { afterEach, beforeEach, describe, it, mock, type TestContext } from 'node:test'
+import { createLocalSource } from './local-source.ts'
+import type { WorkViewSnapshot } from './work-view-api-types.ts'
+import type { WorkModel } from './work-data-source.ts'
+import { SaveRefusedError } from '../data.ts'
+import { createBoundStore } from '../store/create-store.ts'
+import type { StoreEnvironment } from '../store/store-types.ts'
+
+const FIRST = 'a'.repeat(64)
+const SECOND = 'b'.repeat(64)
+const THIRD = 'c'.repeat(64)
+// One clock for every model, so that a snapshot read twice maps to one content.
+const NOW = Date.parse('2026-11-19T12:00:00.000Z')
+
+function snapshot(fingerprint = FIRST): WorkViewSnapshot {
+  const value: WorkViewSnapshot = JSON.parse(readFileSync(new URL('../../test-fixtures/work-view-snapshot.trimmed.json', import.meta.url), 'utf8'))
+  value.humanRequests = [{ ...value.humanRequests[0], id: 'request-a', contentFingerprint: fingerprint }]
+  return value
+}
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } })
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((yes) => { resolve = yes })
+  return { promise, resolve }
+}
+class FakeStream {
+  readyState = 1
+  onopen: (() => void) | null = null
+  onerror: (() => void) | null = null
+  handlers = new Map<string, (event: { data: string }) => void>()
+  addEventListener(type: string, listener: (event: { data: string }) => void) { this.handlers.set(type, listener) }
+  emit(type: string, value: unknown) { this.handlers.get(type)?.({ data: JSON.stringify(value) }) }
+  close() { this.readyState = 2 }
+}
+/** A source whose POSTs wait for `held` and whose GETs `read` answers, by their count; each request is counted. */
+function harness(held: Promise<Response>, read: (get: number) => Promise<Response>) {
+  const streams: FakeStream[] = []
+  const calls = { posts: 0, gets: 0 }
+  const local = createLocalSource({
+    hostname: 'localhost',
+    bootstrapTimeoutMs: 10,
+    fetchImpl: async (_url, init) => {
+      if (init?.method === 'POST') { calls.posts++; return held }
+      calls.gets++
+      return read(calls.gets)
+    },
+    eventSourceFactory: () => { const stream = new FakeStream(); streams.push(stream); return stream as unknown as EventSource },
+  })
+  return { local, streams, calls }
+}
+/** Until `done` holds, or a second: the store's reads run on the source's own timers. */
+async function until(done: () => boolean) {
+  for (let i = 0; i < 200 && !done(); i++) await new Promise<void>((resolve) => setTimeout(resolve, 5))
+}
+/** Two requests, each checked or not, at one version each. */
+function two(a: boolean, b: boolean, bAt = SECOND): WorkViewSnapshot {
+  const value = snapshot()
+  const base = value.humanRequests[0]
+  const at = (checked: boolean) => ({ ...base.review, checked, checkedAtEpoch: checked ? NOW : null })
+  value.humanRequests = [
+    { ...base, id: 'request-a', contentFingerprint: FIRST, review: at(a) } as typeof base,
+    { ...base, id: 'request-b', contentFingerprint: bAt, review: at(b) } as typeof base,
+  ]
+  return value
+}
+const settle = () => new Promise<void>((resolve) => setImmediate(resolve))
+/** The store the pages use, on `local`. */
+function storeOn(local: ReturnType<typeof createLocalSource>) {
+  const items = new Map<string, string>()
+  const environment: StoreEnvironment = {
+    href: () => 'http://localhost/', writeUrl: () => {}, prefersDark: false,
+    storage: { getItem: (key) => items.get(key) ?? null, setItem: (key, value) => { items.set(key, value) }, removeItem: (key) => { items.delete(key) } },
+    reportsUsage: false, sendUsage: () => {}, scrollToTop: () => {},
+  }
+  const store = createBoundStore(environment)
+  const stop = store.getState().startWorkSource(local)
+  const shown = () => { const load = store.getState().work.load; return load.state === 'loaded' ? load.model.requests[0].contentFingerprint : load.state }
+  return { store, stop, shown }
+}
+
+describe('oboete: a save on the polling transport', () => {
+  beforeEach(() => { mock.method(Date, 'now', () => NOW) })
+  afterEach(() => { mock.restoreAll() })
+
+  it('a check answered while a poll of the content on screen lands shows the check', async () => {
+    const held = deferred<Response>()
+    const { local, streams } = harness(held.promise, async () => json(snapshot()))
+    const shown: string[] = []
+    const stop = local.subscribeToLiveUpdates((model) => shown.push(model.requests[0].contentFingerprint!), () => {})
+    try {
+      streams[0].emit('work-view', snapshot())
+      const saving = local.setRequestChecked('request-a', FIRST, true)
+      // A poll read before the write: the content on screen, which reaches no screen again.
+      streams[0].emit('work-view', snapshot())
+      assert.deepEqual(shown, [FIRST])
+      held.resolve(json(snapshot(SECOND)))
+      const result = await saving
+      assert.equal(result.outcome, 'saved')
+      assert.equal('model' in result && result.model.requests[0].contentFingerprint, SECOND)
+    } finally { stop() }
+  })
+
+  it('a suggestion answered while a poll of the content on screen lands shows the answer', async () => {
+    const held = deferred<Response>()
+    const { local, streams } = harness(held.promise, async () => json(snapshot()))
+    const stop = local.subscribeToLiveUpdates(() => {}, () => {})
+    try {
+      streams[0].emit('work-view', snapshot())
+      const suggestion = { conversationKey: 'g:1', requestId: 'g:2', requestTitle: 'A', evidence: '', expectedSuggestionHash: 'h' }
+      const saving = local.answerRequestSuggestion!(suggestion, 'join')
+      streams[0].emit('work-view', snapshot())
+      held.resolve(json({ ...snapshot(SECOND), save: { scope: 'local', state: 'saved' } }))
+      const result = await saving
+      assert.equal(result.model.requests[0].contentFingerprint, SECOND)
+      assert.deepEqual(result.save, { scope: 'local', state: 'saved' })
+    } finally { stop() }
+  })
+
+  it('a save answered after a poll of new content reached the screens keeps that content', async () => {
+    const held = deferred<Response>()
+    const { local, streams } = harness(held.promise, async () => json(snapshot(THIRD)))
+    const stop = local.subscribeToLiveUpdates(() => {}, () => {})
+    try {
+      streams[0].emit('work-view', snapshot())
+      const saving = local.setRequestChecked('request-a', FIRST, true)
+      streams[0].emit('work-view', snapshot(THIRD))
+      held.resolve(json(snapshot(SECOND)))
+      const result = await saving
+      assert.equal('model' in result && result.model.requests[0].contentFingerprint, THIRD)
+    } finally { stop() }
+  })
+
+  it('on the screen: a refusal answered after the store showed a read of the work keeps that read', async () => {
+    const held = deferred<Response>()
+    const read = deferred<Response>()
+    const { local, calls } = harness(held.promise, async () => read.promise)
+    const { store, stop, shown } = storeOn(local)
+    try {
+      const suggestion = { conversationKey: 'g:1', requestId: 'g:2', requestTitle: 'A', evidence: '', expectedSuggestionHash: 'h' }
+      const saving = store.getState().answerRequestSuggestion(suggestion, 'not-this')
+      await until(() => calls.gets === 1)
+      read.resolve(json(snapshot(THIRD)))
+      await until(() => shown() === THIRD)
+      assert.equal(shown(), THIRD)
+      held.resolve(json({ error: 'This suggestion changed while you were reading.', snapshot: snapshot(SECOND) }, 409))
+      await assert.rejects(saving, (error: unknown) => error instanceof SaveRefusedError && error.model.requests[0].contentFingerprint === THIRD)
+      assert.equal(shown(), THIRD)
+    } finally { stop() }
+  })
+
+  for (const order of ['in the order they were asked', 'the second first'] as const) {
+    it(`on the screen: two checks in flight together both show, answered ${order}`, async () => {
+      const held = { a: deferred<Response>(), b: deferred<Response>() }
+      const streams: FakeStream[] = []
+      const local = createLocalSource({
+        hostname: 'localhost',
+        bootstrapTimeoutMs: 10,
+        fetchImpl: async (_url, init) => {
+          if (init?.method === 'POST') return JSON.parse(String(init.body)).requestId === 'request-a' ? held.a.promise : held.b.promise
+          return json(two(true, true))
+        },
+        eventSourceFactory: () => { const stream = new FakeStream(); streams.push(stream); return stream as unknown as EventSource },
+      })
+      const { store, stop } = storeOn(local)
+      const checked = (id: string) => {
+        const load = store.getState().work.load
+        return load.state === 'loaded' && load.model.requests.find((r) => r.id === id)?.checkedAt !== undefined
+      }
+      try {
+        streams[0].emit('work-view', two(false, false))
+        await until(() => store.getState().work.load.state === 'loaded')
+        const a = store.getState().setRequestChecked('request-a', true, FIRST, null)
+        const b = store.getState().setRequestChecked('request-b', true, SECOND, null)
+        if (order === 'in the order they were asked') {
+          held.a.resolve(json(two(true, false)))
+          await a
+          held.b.resolve(json(two(true, true)))
+          await b
+        } else {
+          held.b.resolve(json(two(false, true)))
+          await b
+          held.a.resolve(json(two(true, false)))
+          await a
+        }
+        await until(() => checked('request-a') && checked('request-b'))
+        assert.ok(checked('request-a') && checked('request-b'), 'both checks shown')
+        // A poll of the work as it is now: nothing more to show, and nothing taken for one shown.
+        streams[0].emit('work-view', two(true, true))
+        assert.ok(checked('request-a') && checked('request-b'))
+      } finally { stop() }
+    })
+  }
+
+  it('on the screen: a check that gave way to new work, and a second check answered while the store reads again after the first', async () => {
+    const held = { a: deferred<Response>(), b: deferred<Response>() }
+    const reads: ReturnType<typeof deferred<Response>>[] = []
+    const streams: FakeStream[] = []
+    const local = createLocalSource({
+      hostname: 'localhost',
+      bootstrapTimeoutMs: 10,
+      fetchImpl: async (_url, init) => {
+        if (init?.method === 'POST') return JSON.parse(String(init.body)).requestId === 'request-a' ? held.a.promise : held.b.promise
+        const read = deferred<Response>()
+        reads.push(read)
+        return read.promise
+      },
+      eventSourceFactory: () => { const stream = new FakeStream(); streams.push(stream); return stream as unknown as EventSource },
