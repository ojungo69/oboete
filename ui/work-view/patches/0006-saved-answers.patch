+describe('oboete: a receipt alone, with the minute timer', () => {
+  /** A source half a minute after the request's update, on a clock the test moves. */
+  function aged(t: TestContext, held: Promise<Response>) {
+    t.mock.timers.enable({ apis: ['setInterval', 'setTimeout', 'Date'], now: snapshot().humanRequests[0].updatedAtEpoch! + 30_000 })
+    const originalNow = performance.now
+    performance.now = () => Date.now()
+    const shown: WorkModel[] = []
+    const { local, streams } = harness(held, async () => { throw new TypeError('Failed to fetch') })
+    const stop = local.subscribeToLiveUpdates((model) => shown.push(model), () => {})
+    return { local, streams, shown, stop: () => { stop(); performance.now = originalNow } }
+  }
+
+  for (const kind of ['check', 'suggestion'] as const) {
+    it(`a ${kind} answered after the minute timer aged the screen keeps the aged work`, async (t: TestContext) => {
+      const held = deferred<Response>()
+      const { local, streams, shown, stop } = aged(t, held.promise)
+      try {
+        streams[0].emit('work-view', snapshot())
+        const suggestion = { conversationKey: 'g:1', requestId: 'g:2', requestTitle: 'A', evidence: '', expectedSuggestionHash: 'h' }
+        const saving = kind === 'check' ? local.setRequestChecked('request-a', FIRST, true) : local.answerRequestSuggestion!(suggestion, 'join')
+        t.mock.timers.tick(5 * 60_000)
+        await settle()
+        assert.ok(shown.length >= 2, 'the minute timer sent the work again, aged')
+        held.resolve(json({ ...snapshot(SECOND), save: { scope: 'local', state: 'saved' } }))
+        const result = await saving
+        assert.equal('model' in result && result.model.requests, shown.at(-1)!.requests)
+      } finally { stop() }
+    })
+  }
+
