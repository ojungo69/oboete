+    return { store, stop, streams, load, request }
+  }
+
+  it('on the screen: two checks before any poll, the first answered with its receipt alone and its read failing, the second shows its own answer', async () => {
+    const held = { a: deferred<Response>(), b: deferred<Response>() }
+    const { store, stop, streams, load, request } = failingReads({ a: held.a.promise, b: held.b.promise })
