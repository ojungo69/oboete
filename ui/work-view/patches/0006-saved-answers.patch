+    }
+    try {
+      streams[0].emit('work-view', two(false, false))
+      await until(() => store.getState().work.load.state === 'loaded')
+      const a = store.getState().setRequestChecked('request-a', true, FIRST, null)
+      // New work reaches the screen while the first check is in flight.
+      streams[0].emit('work-view', two(false, false, THIRD))
+      const b = store.getState().setRequestChecked('request-b', true, THIRD, null)
+      held.a.resolve(json(two(true, false)))
