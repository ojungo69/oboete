+  it('a receipt whose read again fails after a refusal showed newer work stands on that work', async () => {
+    const posts = [json({ error: 'This work changed while you were reading.', snapshot: snapshot(THIRD) }, 409), json({ save: { scope: 'local', state: 'saved' } })]
+    const streams: FakeStream[] = []
+    const local = createLocalSource({
+      hostname: 'localhost',
+      fetchImpl: async (_url, init) => { if (init?.method === 'POST') return posts.shift()!; throw new TypeError('Failed to fetch') },
+      eventSourceFactory: () => { const stream = new FakeStream(); streams.push(stream); return stream as unknown as EventSource },
+    })
+    const stop = local.subscribeToLiveUpdates(() => {}, () => {})
+    try {
+      streams[0].emit('work-view', snapshot())
+      const refused = await local.setRequestChecked('request-a', FIRST, true)
+      assert.equal(refused.outcome, 'changed-while-reading')
+      const result = await local.setRequestChecked('request-a', THIRD, true)
+      assert.equal(result.outcome === 'saved' && result.model.requests[0].contentFingerprint, THIRD)
+    } finally { stop() }
+  })
+
+  it('a 200 with neither a snapshot nor a receipt still says it was not shown', async () => {
+    const { local, streams } = harness(Promise.resolve(json({ ok: true })), async () => json(snapshot()))
+    const stop = local.subscribeToLiveUpdates(() => {}, () => {})
+    try {
+      streams[0].emit('work-view', snapshot())
+      await assert.rejects(local.setRequestChecked('request-a', FIRST, true), /not a work snapshot/)
+      const suggestion = { conversationKey: 'g:1', requestId: 'g:2', requestTitle: 'A', evidence: '', expectedSuggestionHash: 'h' }
+      await assert.rejects(local.answerRequestSuggestion!(suggestion, 'join'), /not a work snapshot/)
+    } finally { stop() }
+  })
+})
+
+describe('oboete: a receipt alone, with the minute timer', () => {
+  /** A source half a minute after the request's update, on a clock the test moves. */
+  function aged(t: TestContext, held: Promise<Response>) {
+    t.mock.timers.enable({ apis: ['setInterval', 'setTimeout', 'Date'], now: snapshot().humanRequests[0].updatedAtEpoch! + 30_000 })
+    const originalNow = performance.now
+    performance.now = () => Date.now()
+    const shown: WorkModel[] = []
+    const { local, streams } = harness(held, async () => { throw new TypeError('Failed to fetch') })
+    const stop = local.subscribeToLiveUpdates((model) => shown.push(model), () => {})
+    return { local, streams, shown, stop: () => { stop(); performance.now = originalNow } }
+  }
+
+  for (const kind of ['check', 'suggestion'] as const) {
+    it(`a ${kind} answered after the minute timer aged the screen keeps the aged work`, async (t: TestContext) => {
+      const held = deferred<Response>()
+      const { local, streams, shown, stop } = aged(t, held.promise)
+      try {
+        streams[0].emit('work-view', snapshot())
+        const suggestion = { conversationKey: 'g:1', requestId: 'g:2', requestTitle: 'A', evidence: '', expectedSuggestionHash: 'h' }
+        const saving = kind === 'check' ? local.setRequestChecked('request-a', FIRST, true) : local.answerRequestSuggestion!(suggestion, 'join')
+        t.mock.timers.tick(5 * 60_000)
+        await settle()
+        assert.ok(shown.length >= 2, 'the minute timer sent the work again, aged')
+        held.resolve(json({ ...snapshot(SECOND), save: { scope: 'local', state: 'saved' } }))
+        const result = await saving
+        assert.equal('model' in result && result.model, shown.at(-1))
+      } finally { stop() }
+    })
+  }
+
+
+  it('a receipt whose read again fails stands on the work on screen, as the minute timer aged it', async (t: TestContext) => {
+    // Half a minute after the request's update, so that each minute moves what the screen says of it.
+    t.mock.timers.enable({ apis: ['setInterval', 'setTimeout', 'Date'], now: snapshot().humanRequests[0].updatedAtEpoch! + 30_000 })
+    const originalNow = performance.now
+    performance.now = () => Date.now()
+    const shown: WorkModel[] = []
+    const { local, streams } = harness(Promise.resolve(json({ save: { scope: 'local', state: 'saved' } })), async () => { throw new TypeError('Failed to fetch') })
+    const stop = local.subscribeToLiveUpdates((model) => shown.push(model), () => {})
+    try {
+      streams[0].emit('work-view', snapshot())
+      t.mock.timers.tick(5 * 60_000)
+      await settle()
+      assert.ok(shown.length >= 2, 'the minute timer sent the work again, aged')
+      const result = await local.setRequestChecked('request-a', FIRST, true)
+      assert.equal(result.outcome, 'saved')
+      assert.equal(result.outcome === 'saved' && result.model, shown.at(-1))
+    } finally { stop(); performance.now = originalNow }
+  })
+})
