+export function switchChange(rule: OwnerRule, on: boolean): RuleChange {
+  const version = ruleVersion(rule)
+  return { action: on ? 'turn-on' : 'turn-off', ruleId: rule.id, ...(version ? { ruleVersion: version } : {}) }
+}
+
+/**
+ * Added by oboete (0010, #1083): a rule change's receipt as the screen shows it now, its rule named by `name` from the rules
+ * on screen (their texts gated with each read), and none once the rule is gone from the screen (forgotten, removed), so a
+ * receipt keeps no text the screen no longer shows. A receipt of no rule is as it was.
+ */
+export function receiptOnScreen<R extends { ruleId: string | null; message?: { source: string; values?: Record<string, unknown> } }>(record: R, rules: OwnerRule[], name: (rule: OwnerRule) => string): R | null {
+  if (!record.ruleId) return record
+  const rule = rules.find((entry) => entry.id === record.ruleId)
