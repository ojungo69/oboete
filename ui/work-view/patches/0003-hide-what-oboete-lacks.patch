+// Added by oboete (ui/work-view/patches/0003-hide-what-oboete-lacks.patch): oboete has no installer, so no
+// address opens one (issue #1085). claude-mem's `npm test` runs this file with its own.
+import assert from 'node:assert/strict'
+import { describe, it } from 'node:test'
+import { readRoute } from './slices/view-slice.ts'
+
+describe('oboete has no installer', () => {
+  it('opens My Work at an address that asks for setup, and keeps the rest of the address', () => {
+    assert.equal(readRoute(new URL('http://work-view.localhost:17373/work-view/?setup=1')).page, 'app')
+    const route = readRoute(new URL('http://work-view.localhost:17373/work-view/?setup=1&view=rules&request=r1'))
+    assert.deepEqual([route.page, route.section, route.requestId], ['app', 'rules', 'r1'])
+  })
+})
