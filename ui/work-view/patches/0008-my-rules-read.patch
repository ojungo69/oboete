+
+// Added by oboete (ui/work-view/patches/0008-my-rules-read.patch, #1083): a rule's age moves with every
+// mapping, so the same snapshot mapped a minute later is the same content.
+describe('oboete: a snapshot with a rule, mapped again a minute later', () => {
+  let now = NOW
+  beforeEach(() => { now = NOW; mock.method(Date, 'now', () => now) })
+  afterEach(() => { mock.restoreAll() })
+  const ruled = (fingerprint = FIRST): WorkViewSnapshot => ({
+    ...snapshot(fingerprint),
+    ruleScopes: [{ id: 'everywhere', tier: 'everywhere', name: 'Everywhere' }],
+    rules: [{
+      ruleId: 'l:aaaaaaaaaaaa', scopeId: 'everywhere', scopeTier: 'everywhere', scopeName: 'Everywhere', when: '',
+      then: 'Keep commits small.', setBy: 'learned', status: 'suggested', kind: 'preference', source: 'request-progress',
+      timesSeen: 2, latestAt: '2026-11-18T09:30:00.000Z',
+      quotes: [{ at: '2026-11-18T09:30:00.000Z', quote: 'Make each commit one change.', kind: 'correction' }],
+      replacedBy: null, replacedAt: null, savedAt: null,
+    }],
+  }) as WorkViewSnapshot
+
+  it('reaches no screen again, so a check answered meanwhile shows the check though every read fails', async () => {
+    const held = deferred<Response>()
+    const { local, streams } = harness(held.promise, async () => json({ error: 'down' }, 503))
+    const shown: string[] = []
+    const stop = local.subscribeToLiveUpdates((model) => shown.push(model.requests[0].contentFingerprint!), () => {})
+    try {
+      streams[0].emit('work-view', ruled())
+      const saving = local.setRequestChecked('request-a', FIRST, true)
+      now = NOW + 60_000
+      streams[0].emit('work-view', ruled())
+      assert.deepEqual(shown, [FIRST])
+      held.resolve(json(ruled(SECOND)))
+      const result = await saving
+      assert.equal(result.outcome, 'saved')
+      assert.equal('model' in result && result.model.requests[0].contentFingerprint, SECOND)
+    } finally { stop() }
+  })
+})
