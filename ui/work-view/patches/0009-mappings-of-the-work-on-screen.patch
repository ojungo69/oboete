+      })
+      const b = store.getState().setRequestChecked('request-b', true, SECOND, null)
+      t.mock.timers.tick(60_000)
+      await settled()
+      held.b.resolve(json({ ...goaled(ruledAt(two(true, true), NOW), NOW + 61_000), save: saved }))
+      await b
+      await settled()
+      assert.ok(checked('request-a') && checked('request-b'), 'the second check is shown')
+      assert.equal(store.getState().work.refreshError, null)
