+  const ruledAt = (value: WorkViewSnapshot, at: number): WorkViewSnapshot => {
+    const quoted = new Date(at - DAY_MS + 30_000).toISOString()
+    return {
+      ...value,
+      ruleScopes: [{ id: 'everywhere', tier: 'everywhere', name: 'Everywhere' }],
+      rules: [{
+        ruleId: `l:${'a'.repeat(64)}`, scopeId: 'everywhere', scopeTier: 'everywhere', scopeName: 'Everywhere', when: '',
+        then: 'Keep commits small.', setBy: 'learned', status: 'suggested', kind: 'preference', source: 'request-progress',
+        timesSeen: 2, latestAt: quoted, quotes: [{ at: quoted, quote: 'Make each commit one change.', kind: 'correction' }],
+        replacedBy: null, replacedAt: null, savedAt: null,
+      }],
+    } as WorkViewSnapshot
+  }
+  /**
+   * `value` with a goals list and a past month of them as oboete writes them, each stamped with the time of the read, and
+   * the snapshot with that time as oboete stamps it (`revision`).
+   */
+  const goaled = (value: WorkViewSnapshot, readAt: number, prompts = 3): WorkViewSnapshot => {
+    const list = (id: string, history: boolean) => ({
+      listId: id, listName: history ? '2026-10' : 'goals', history, project: '', updatedAt: new Date(readAt).toISOString(),
+      periodStart: history ? '2026-10-01' : '2026-11-12', periodEnd: history ? '2026-11-01' : '2026-11-20',
+      summary: history ? 'A month of parsers.' : null, generatedAt: history ? null : '2026-11-19T11:00:00.000Z',
+      windowDays: history ? null : 7, sourcePromptCount: prompts, mapPath: null, areas: [], asks: [],
+    })
+    return {
+      ...value, revision: String(readAt), goals: list('goals', false), goalHistory: [list('goals:2026-10', true)],
+    } as unknown as WorkViewSnapshot
+  }
+  /** Whether `store` shows both periods of the goals mapped. */
+  const goalsMapped = (store: ReturnType<typeof storeOn>['store']) => {
+    const load = store.getState().work.load
