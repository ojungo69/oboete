+    const held = { a: deferred<Response>(), b: deferred<Response>() }
+    const streams: FakeStream[] = []
+    const local = createLocalSource({
+      hostname: 'localhost',
+      bootstrapTimeoutMs: 10,
+      fetchImpl: async (_url, init) => {
+        if (init?.method === 'POST') return JSON.parse(String(init.body)).requestId === 'request-a' ? held.a.promise : held.b.promise
