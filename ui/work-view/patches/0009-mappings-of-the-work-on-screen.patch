+    performance.now = () => Date.now()
+    return () => { performance.now = originalNow }
+  }
+  const settled = async () => { for (let i = 0; i < 20; i++) await settle() }
+  const saved = { scope: 'local', state: 'saved' }
+
+  // A rule quoted a day, less half a minute, before the start passes a whole day at the next minute; one quoted a minute
+  // before midnight stays in its day as the date passes, and only its time's label moves.
+  for (const [boundary, start, quotedAt] of [["a rule's day", NOW, NOW - DAY_MS + 30_000], ['midnight', midnight - 30_000, midnight - 90_000]] as const) {
+    it(`on the screen: a check answered after the minute timer passed ${boundary}, every read failing, shows the check`, async (t: TestContext) => {
+      const restore = clock(t, start)
