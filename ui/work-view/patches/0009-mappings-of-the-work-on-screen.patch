+      const { store, stop, shown } = storeOn(local)
+      const rule = () => { const load = store.getState().work.load; return load.state === 'loaded' ? load.model.rules[0] : null }
+      try {
+        streams[0].emit('work-view', ruledAt(snapshot(FIRST), quotedAt + DAY_MS - 30_000))
+        await settled()
+        assert.equal(shown(), FIRST)
+        const saving = store.getState().setRequestChecked('request-a', true, FIRST, null)
+        const before = rule()!
+        t.mock.timers.tick(60_000)
+        await settled()
+        const after = rule()!
+        if (boundary === 'midnight') {
+          assert.equal(Math.floor(after.latestDaysAgo), Math.floor(before.latestDaysAgo), 'the rule stays in its day')
+          assert.notEqual(after.latestAt, before.latestAt, "the timer showed the rule's time as of the next day")
+        } else assert.equal(Math.floor(after.latestDaysAgo), Math.floor(before.latestDaysAgo) + 1, 'the timer showed the rule a day older')
+        held.resolve(json({ ...ruledAt(snapshot(SECOND), quotedAt + DAY_MS - 30_000), save: saved }))
+        await saving
+        await settled()
+        assert.equal(shown(), SECOND)
+        assert.equal(store.getState().work.refreshError, null)
+      } finally { stop(); restore() }
+    })
+  }
+
+  it("on the screen: after a check's answer, a poll of it in a new envelope and the minute timer leave the next check its answer, every read failing", async (t: TestContext) => {
