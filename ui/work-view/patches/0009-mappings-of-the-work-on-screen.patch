+  })
+
+  it('on the screen: a read answered after the minute timer mapped the work on screen again shows the read', async (t: TestContext) => {
+    const restore = clock(t, NOW)
+    const read = deferred<Response>()
+    const streams: FakeStream[] = []
+    const local = createLocalSource({
